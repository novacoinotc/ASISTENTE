# Base de datos Neon PostgreSQL (REQUERIDO)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# OpenAI API Key (REQUERIDO para IA autónoma)
# Se usa para: GPT-4 (análisis), GPT-4 Vision (imágenes), Whisper (audio)
OPENAI_API_KEY=sk-xxx

# WhatsApp Web Service (REQUERIDO - Método principal)
# Puerto donde corre el servicio de WhatsApp
WHATSAPP_SERVICE_PORT=3001
NEXT_PUBLIC_WHATSAPP_SERVICE_URL=http://localhost:3001

# Proxy residencial (REQUERIDO para servidores en la nube)
# Formato: socks5://user:pass@host:port o http://user:pass@host:port
# Obtén uno en: https://brightdata.com o https://oxylabs.io
PROXY_URL=socks5://user:password@proxy.brightdata.com:22225

# WhatsApp Business API (OPCIONAL - Solo si prefieres API oficial)
# NOTA: La API oficial desconecta WhatsApp de tu teléfono
# WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_secreto
# WHATSAPP_ACCESS_TOKEN=tu_access_token_de_meta
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id

# Número de WhatsApp del dueño (para recibir resúmenes diarios)
OWNER_WHATSAPP_NUMBER=521234567890

# Secreto para cron jobs (seguridad)
CRON_SECRET=tu_secreto_para_cron_jobs

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
